# 应用运行环境：dev | production
# dev 使用 Gin debug 模式 + 彩色可读日志；production 使用 release 模式 + JSON 日志
AppEnv=dev

# 日志级别：debug | info | warn | error（大小写不敏感，未知值按 info 处理）
LogLevel=info

# ---------------------------------------------------------------------------
# PostgreSQL 数据库
# ---------------------------------------------------------------------------
# 连接串格式：postgres://用户名:密码@主机:端口/库名?sslmode=disable
DatabaseDSN=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
# 连接池最大打开连接数
DatabaseMaxOpenConns=25
# 连接池最大空闲连接数
DatabaseMaxIdleConns=10
# 连接可复用的最长时间，超时后关闭重建（Go duration：30m、1h）
DatabaseConnMaxLifetime=30m
# 空闲连接被回收前的最长保留时间
DatabaseConnMaxIdleTime=5m
# 启动时数据库连通性探测的超时时间
DatabasePingTimeout=5s

# ---------------------------------------------------------------------------
# Redis（ZITADEL 会话存储）
# ---------------------------------------------------------------------------
# 地址，格式 host:port
RedisAddr=localhost:6379
# 无密码时留空
RedisPassword=
# 逻辑库编号
RedisDB=0

# ---------------------------------------------------------------------------
# HTTP 服务器
# ---------------------------------------------------------------------------
# 监听地址，容器部署一般用 :8080
HTTPAddr=:8080
# 健康检查子命令（-healthcheck）读取的地址变量，需与 HTTPAddr 保持一致
# 未设置时回退到 :8080
APP_HTTP_ADDR=:8080
# 读取请求头的超时，防慢请求攻击
HTTPReadHeaderTimeout=5s
# 读取整个请求的超时
HTTPReadTimeout=15s
# 写入响应的超时
HTTPWriteTimeout=15s
# Keep-Alive 空闲连接超时
HTTPIdleTimeout=60s

# ---------------------------------------------------------------------------
# ZITADEL 认证（以下四项为必填，任一为空则启动失败）
# ---------------------------------------------------------------------------
# ZITADEL 实例域名，不带协议头，例如 zitadel.example.com
ZITADEL_DOMAIN=
# 任意 32 字节密钥，用于会话数据加解密
ZITADEL_KEY=
# OIDC 应用的 Client ID
ZITADEL_CLIENT_ID=
# OIDC 回调地址，必须与 ZITADEL 控制台配置完全一致
ZITADEL_REDIRECT_URI=http://localhost:8080/api/v1/auth/callback

# 会话键在 Redis 中的前缀，用于与业务数据隔离
ZITADEL_SESSION_KEY_PREFIX=zitadel:session:
# 拿不到 ID Token 过期时间时的兜底有效期。会话没有删除入口，
# 若退化为 0 会导致键永久驻留，请确保为正值
ZITADEL_SESSION_FALLBACK_TTL=24h
# 单次 Redis 操作的超时，防止 Redis 抖动拖垮认证链路
ZITADEL_SESSION_REDIS_OP_TIMEOUT=2s
